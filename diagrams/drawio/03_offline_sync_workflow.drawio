          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision 2: HTTP 200? -->
        <mxCell id="dec2" value="HTTP 200 Received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="420" y="590" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_ingest_dec2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="step_ingest" target="dec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- [No] Ingestion Failed -->
        <mxCell id="step_fail" value="Log Ingestion Failure &amp;amp; Requeue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
