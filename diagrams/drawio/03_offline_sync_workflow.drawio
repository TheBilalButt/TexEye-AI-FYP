          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="step_ingest" value="Central Server Validates &amp;amp; Ingests Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
