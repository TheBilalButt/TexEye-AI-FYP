        <!-- Step 1 -->
        <mxCell id="step1" value="Query Pending Batches from Outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
