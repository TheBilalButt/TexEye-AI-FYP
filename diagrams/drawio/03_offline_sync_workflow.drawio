        <mxCell id="e_dec1_ser" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="dec1" target="step_ser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="step_trans" value="Transmit Batch via HTTPS REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="450" width="280" height="42" as="geometry" />
