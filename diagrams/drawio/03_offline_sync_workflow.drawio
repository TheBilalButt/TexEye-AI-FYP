        <mxCell id="e_dec1_retry" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="dec1" target="step_retry">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="step_backoff" value="Apply Exponential Backoff Delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
