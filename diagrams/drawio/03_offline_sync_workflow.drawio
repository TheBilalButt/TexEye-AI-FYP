        </mxCell>

        <mxCell id="step_update" value="Update Central Defect Map &amp;amp; Inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
