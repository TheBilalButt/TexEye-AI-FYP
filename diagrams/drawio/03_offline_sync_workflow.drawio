<mxfile host="app.diagrams.net" modified="2026-11-11T09:00:00.000Z" agent="TexEye AI Architect" version="22.1.0" type="device">
  <diagram id="texeye_sync_workflow" name="Offline-Online Sync Workflow">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;TexEye AI: Offline / Online Resilient Data Synchronization Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Edge Persistence, Transaction Queuing, Heartbeat Probing &amp;amp; Idempotent Central Ingestion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="760" height="60" as="geometry" />
        </mxCell>

        <!-- Start Event -->
        <mxCell id="node_event" value="&lt;b&gt;Inspection Event Occurs on Edge&lt;/b&gt;&lt;br&gt;Defect Discovered, Roll Status Changed, or Uninspected Section Flagged" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#0369a1;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="105" width="500" height="50" as="geometry" />
        </mxCell>

        <!-- Subgraph: Edge Storage -->
        <mxCell id="box_edge_store" value="&lt;b&gt;Local Edge Storage Tier (Always Active &amp;amp; ACID Compliant)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="250" y="180" width="1020" height="150" as="geometry" />
        </mxCell>
        <mxCell id="db_local" value="&lt;b&gt;Local SQLite DB&lt;/b&gt;&lt;br&gt;Insert Row with UUIDv4&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;sync_status = 'PENDING'&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.5;fontSize=11;" vertex="1" parent="box_edge_store">
          <mxGeometry x="100" y="45" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="disk_img" value="&lt;b&gt;Local Flash / NVMe Cache&lt;/b&gt;&lt;br&gt;Store Defect Crop / Frame&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;/var/texeye/img_cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.5;fontSize=11;" vertex="1" parent="box_edge_store">
          <mxGeometry x="400" y="55" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="queue_table" value="&lt;b&gt;Offline Sync Queue Outbox&lt;/b&gt;&lt;br&gt;Append Transaction Log Entry&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;FIFO Ordered Operations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=11;" vertex="1" parent="box_edge_store">
          <mxGeometry x="700" y="55" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_db_q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d97706;strokeWidth=1.5;" edge="1" source="db_local" target="queue_table" parent="box_edge_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_ev_edge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284c7;strokeWidth=2;" edge="1" source="node_event" target="db_local" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_ev_img" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284c7;strokeWidth=2;" edge="1" source="node_event" target="disk_img" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Network Decision -->
        <mxCell id="chk_conn" value="&lt;b&gt;Central Backend Reachable?&lt;/b&gt;&lt;br&gt;HTTPS Heartbeat &amp;bull; Latency &amp;lt; 1500ms" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="580" y="370" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="edge_q_chk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" source="queue_table" target="chk_conn" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Offline Outage Handling -->
        <mxCell id="box_offline_handling" value="&lt;b&gt;Offline Outage State (No Internet / Network Severed)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=12;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="150" y="520" width="450" height="160" as="geometry" />
        </mxCell>
        <mxCell id="node_offline_act" value="&lt;b&gt;1. Edge Continues Inspection at Full Speed&lt;/b&gt;&lt;br&gt;Zero shop-floor stoppage. Zero lost inspections." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;fontSize=11;" vertex="1" parent="box_offline_handling">
          <mxGeometry x="30" y="40" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="node_offline_buffer" value="&lt;b&gt;2. Accumulate in Outbox &amp;amp; Exponential Backoff&lt;/b&gt;&lt;br&gt;Retry heartbeat probe with jitter every N seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;fontSize=11;" vertex="1" parent="box_offline_handling">
          <mxGeometry x="30" y="95" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="edge_conn_no" value="&lt;b&gt;NO (Connection Lost)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#dc2626;" edge="1" source="chk_conn" target="box_offline_handling" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Online Sync Transmission -->
        <mxCell id="box_sync_tx" value="&lt;b&gt;Online Transmission &amp;amp; Central Ingestion Tier&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="660" y="520" width="780" height="260" as="geometry" />
        </mxCell>

        <mxCell id="node_batch" value="&lt;b&gt;Sync Agent Packs Pending Batch&lt;/b&gt;&lt;br&gt;Fetch top 50 records + base64/multipart crops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="box_sync_tx">
          <mxGeometry x="40" y="45" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_post" value="&lt;b&gt;HTTPS POST /api/v1/sync/batch&lt;/b&gt;&lt;br&gt;TLS 1.3 encrypted transmission + HMAC check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="box_sync_tx">
          <mxGeometry x="420" y="45" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_central_ingest" value="&lt;b&gt;Central Backend Transactional Ingestion&lt;/b&gt;&lt;br&gt;&amp;bull; Upsert PostgreSQL using UUIDs (Idempotent)&lt;br&gt;&amp;bull; Stream images to Cloud MinIO/S3 Bucket&lt;br&gt;&amp;bull; Broadcast updates to Web Defect Map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=11;" vertex="1" parent="box_sync_tx">
          <mxGeometry x="180" y="125" width="450" height="65" as="geometry" />
        </mxCell>
        <mxCell id="node_ack" value="&lt;b&gt;Return HTTP 200 OK &amp;amp; Synced IDs Acknowledgment&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="box_sync_tx">
          <mxGeometry x="180" y="205" width="450" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e_batch_post" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=1.5;" edge="1" source="node_batch" target="node_post" parent="box_sync_tx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_post_ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=1.5;" edge="1" source="node_post" target="node_central_ingest" parent="box_sync_tx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ingest_ack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=1.5;" edge="1" source="node_central_ingest" target="node_ack" parent="box_sync_tx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_conn_yes" value="&lt;b&gt;YES (Online / Restored)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;" edge="1" source="chk_conn" target="node_batch" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_reconnect" value="When link recovers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=1.5;dashed=1;" edge="1" source="box_offline_handling" target="node_batch" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Final Clean Step -->
        <mxCell id="node_cleanup" value="&lt;b&gt;Edge Marks Outbox Status as 'SYNCED'&lt;/b&gt;&lt;br&gt;Evict uploaded images according to local retention policy (FIFO storage ceiling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="580" y="820" width="580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_ack_clean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;" edge="1" source="node_ack" target="node_cleanup" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
