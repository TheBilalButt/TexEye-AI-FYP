          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="step_evict" value="Evict Synced Images from Local Cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="765" width="280" height="42" as="geometry" />
