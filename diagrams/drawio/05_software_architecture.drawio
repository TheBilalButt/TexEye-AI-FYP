<mxfile host="app.diagrams.net" modified="2026-11-11T09:00:00.000Z" agent="TexEye AI Architect" version="22.1.0" type="device">
  <diagram id="texeye_software_arch" name="Layered Software Architecture">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;TexEye AI: Layered Software Architecture &amp;amp; Service Intercommunication&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Muhammad Afnan Khan (App/Web/Cloud) &amp;bull; Muhammad Bilal Butt (AI/Edge/Hardware)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="840" height="60" as="geometry" />
        </mxCell>

        <!-- Layer E: UI Layer -->
        <mxCell id="layer_ui" value="&lt;b&gt;E. User Interface Layer (Client Tier)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontColor=#831843;" vertex="1" parent="1">
          <mxGeometry x="150" y="110" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ui_mob" value="&lt;b&gt;Mobile Application Client&lt;/b&gt;&lt;br&gt;[Proposed: Flutter / React Native]&lt;br&gt;&amp;bull; Instant Push &amp;amp; Sound Alerts &amp;bull; Integrated QR Code Scanner&lt;br&gt;&amp;bull; Defect Review &amp;amp; On-Screen Annotation / Correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f472b6;fontSize=11;" vertex="1" parent="layer_ui">
          <mxGeometry x="60" y="45" width="550" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ui_web" value="&lt;b&gt;Web Dashboard Client&lt;/b&gt;&lt;br&gt;[Proposed: React + TypeScript + Tailwind]&lt;br&gt;&amp;bull; Digital Fabric Defect Map (Color-Coded Roll Canvas)&lt;br&gt;&amp;bull; Roll Grading (4-Point Standard) &amp;amp; Inventory Management&lt;br&gt;&amp;bull; PDF Inspection Report Export &amp;amp; Executive Defect Analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f472b6;fontSize=11;" vertex="1" parent="layer_ui">
          <mxGeometry x="690" y="45" width="550" height="80" as="geometry" />
        </mxCell>

        <!-- Layer C: Backend Layer -->
        <mxCell id="layer_backend" value="&lt;b&gt;C. Central Backend / Application Layer [Proposed: FastAPI / Python ASGI]&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="150" y="300" width="1300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="srv_auth" value="Auth &amp;amp; RBAC Service&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;JWT Tokens &amp;bull; Role Scopes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="40" y="45" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="srv_roll" value="Roll Management Service&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Batches, QR Codes, Metrology&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="290" y="45" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="srv_defect" value="Defect Records Service&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Review, Verification, History&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="540" y="45" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="srv_grade" value="Fabric Grading Engine&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Standard 4-Point System&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="790" y="45" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="srv_notif" value="Notification Hub&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;WebSocket &amp;bull; Push Alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="1040" y="45" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="srv_sync_rcv" value="Central Sync Ingestion Receiver&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Idempotent UUID Ingestion &amp;bull; Transaction Acks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="40" y="135" width="350" height="65" as="geometry" />
        </mxCell>
        <mxCell id="srv_inv" value="Inventory &amp;amp; Scrap Manager&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Warehouse Bin Allocation &amp;bull; Quarantine Flagging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="430" y="135" width="390" height="65" as="geometry" />
        </mxCell>
        <mxCell id="srv_report" value="Reporting &amp;amp; Statistics Engine&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Automated PDF Export &amp;bull; Aggregated Defect Rates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;" vertex="1" parent="layer_backend">
          <mxGeometry x="860" y="135" width="400" height="65" as="geometry" />
        </mxCell>

        <!-- Communication E -> C -->
        <mxCell id="e_ui_backend" value="HTTPS REST &amp;amp; WebSockets (TLS 1.3 / Bearer Token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#db2777;strokeWidth=2;fontColor=#9d174d;" edge="1" source="ui_mob" target="layer_backend" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layer D: Data Layer -->
        <mxCell id="layer_data" value="&lt;b&gt;D. Data Persistence Tier (Central + Edge Split)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=13;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="150" y="570" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="db_pg" value="&lt;b&gt;PostgreSQL Central DB&lt;/b&gt;&lt;br&gt;Rolls, Defects, Grades, Users&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;ACID Relational Storage&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#f59e0b;fontSize=11;" vertex="1" parent="layer_data">
          <mxGeometry x="60" y="45" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="store_s3" value="&lt;b&gt;Cloud Object Store (MinIO/S3)&lt;/b&gt;&lt;br&gt;Defect Bounding Box Crops&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;High-Resolution Imagery Archive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;fontSize=11;" vertex="1" parent="layer_data">
          <mxGeometry x="360" y="45" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db_sqlite" value="&lt;b&gt;Edge SQLite DB (Local)&lt;/b&gt;&lt;br&gt;Autonomous Offline Sessions&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Local Zero-Latency Caching&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#f59e0b;fontSize=11;" vertex="1" parent="layer_data">
          <mxGeometry x="690" y="45" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db_queue" value="&lt;b&gt;Offline Sync Outbox Queue&lt;/b&gt;&lt;br&gt;Pending Sync Transactions&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Guaranteed Eventual Consistency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=11;" vertex="1" parent="layer_data">
          <mxGeometry x="990" y="45" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Communication C -> D -->
        <mxCell id="e_backend_data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;" edge="1" source="srv_sync_rcv" target="db_pg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layer B: AI Processing Layer -->
        <mxCell id="layer_ai" value="&lt;b&gt;B. AI Vision, Tracking &amp;amp; Metrology Layer [Proposed: PyTorch / ONNX Runtime / TensorRT]&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=2;fontSize=13;fontColor=#581c87;" vertex="1" parent="1">
          <mxGeometry x="150" y="760" width="1300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ai_prep" value="Image Preprocessing &amp;amp; CLAHE&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Contrast normalization &amp;bull; ROI mask&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;fontSize=11;" vertex="1" parent="layer_ai">
          <mxGeometry x="40" y="55" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ai_yolo" value="&lt;b&gt;Defect Detection Model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;YOLO Object Detection Backbone&lt;br&gt;Outputs: Class, Confidence, BBox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;fontSize=11;" vertex="1" parent="layer_ai">
          <mxGeometry x="290" y="55" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ai_tracker" value="&lt;b&gt;Multi-Frame Defect Tracker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Kalman Filter + IoU Association&lt;br&gt;Maintains active trajectory tracks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;fontSize=11;" vertex="1" parent="layer_ai">
          <mxGeometry x="560" y="55" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ai_dedup" value="&lt;b&gt;Duplicate Reduction Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Spatial-Temporal Suppression&lt;br&gt;Prevents repeated defect counting&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;fontSize=11;" vertex="1" parent="layer_ai">
          <mxGeometry x="820" y="55" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ai_metrology" value="&lt;b&gt;Physical Coordinate Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Y_m via encoder integration&lt;br&gt;X_cm via camera pixel calibration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;fontSize=11;" vertex="1" parent="layer_ai">
          <mxGeometry x="1070" y="55" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Layer A: Hardware / Edge Layer -->
        <mxCell id="layer_edge" value="&lt;b&gt;A. Hardware &amp;amp; Edge Sensor Layer (Device Telemetry &amp;amp; Health Gates)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="150" y="980" width="1300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="edge_cam_svc" value="Camera Capture Service&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;High-Speed Image Streaming&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=11;" vertex="1" parent="layer_edge">
          <mxGeometry x="40" y="55" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_enc_svc" value="Rotary Encoder Service&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Hardware Pulse Counter Listener&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=11;" vertex="1" parent="layer_edge">
          <mxGeometry x="280" y="55" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_rel_gate" value="&lt;b&gt;Inspection Reliability Monitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Checks: Camera Ping &amp;bull; Light Uniformity&lt;br&gt;Blur / Focus &amp;bull; Dropped Frame Counters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=11;" vertex="1" parent="layer_edge">
          <mxGeometry x="530" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="edge_uninspect" value="&lt;b&gt;Uninspected Section Handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#dc2626;&quot;&gt;Flags degraded span as UNINSPECTED&lt;br&gt;Bypasses AI model &amp;bull; Alerts floor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=11;fontColor=#991b1b;" vertex="1" parent="layer_edge">
          <mxGeometry x="860" y="50" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="edge_sync_daemon" value="Edge Sync Daemon&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Background HTTP retry worker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=11;" vertex="1" parent="layer_edge">
          <mxGeometry x="1100" y="55" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- Inter-Layer Data Flows -->
        <mxCell id="e_edge_ai" value="Qualified Clean Frames" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1d4ed8;" edge="1" source="edge_rel_gate" target="ai_prep" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ai_store" value="Unique Metric Defect Records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333ea;strokeWidth=2;fontColor=#6b21a8;" edge="1" source="ai_metrology" target="db_sqlite" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1270" y="740" />
              <mxPoint x="970" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_uninspect_store" value="Uninspected Interval [L1, L2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#b91c1c;" edge="1" source="edge_uninspect" target="db_sqlite" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sync_uplink" value="HTTPS Sync Batches (TLS 1.3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;" edge="1" source="edge_sync_daemon" target="srv_sync_rcv" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1470" y="1060" />
              <mxPoint x="1470" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
