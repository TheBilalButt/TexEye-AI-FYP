          <mxGeometry x="25" y="115" width="430" height="55" as="geometry" />
        </mxCell>
        <mxCell id="if_light" value="&lt;b&gt;Lighting Driver / Controller&lt;/b&gt; [Proposed]&lt;br&gt;&amp;bull; Constant-Current LED Driver (24V DC)&lt;br&gt;&amp;bull; Optional PWM Strobe / Digital Dimming Controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;fontSize=11;" vertex="1" parent="box_interfaces">
          <mxGeometry x="25" y="185" width="430" height="55" as="geometry" />
        </mxCell>
