<mxfile host="app.diagrams.net" modified="2026-11-11T09:00:00.000Z" agent="TexEye AI Architect" version="22.1.0" type="device">
  <diagram id="texeye_hardware_arch" name="Hardware Architecture &amp; Interfaces">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;TexEye AI: Hardware Architecture &amp;amp; Physical Connection Diagram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Muhammad Bilal Butt (FA23-BAI-042) &amp;bull; Hardware Integration &amp;amp; Edge Sensing Lead&lt;br&gt;&lt;i&gt;Note: Interfaces and specific hardware models are proposed engineering alternatives pending final physical prototype selection.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="860" height="75" as="geometry" />
        </mxCell>

        <!-- Subgraph: Physical Inspection Line -->
        <mxCell id="box_stand" value="&lt;b&gt;Fabric Inspection Stand (Confirmed Subsystem)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="460" height="340" as="geometry" />
        </mxCell>
        <mxCell id="hw_roller" value="&lt;b&gt;Idler / Measurement Roller&lt;/b&gt;&lt;br&gt;Direct friction contact with fabric web&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Precision ground diameter for pulse calibration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="box_stand">
          <mxGeometry x="30" y="50" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hw_fabric" value="&lt;b&gt;Continuous Fabric Web&lt;/b&gt;&lt;br&gt;Woven / Knitted Textile under inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;" vertex="1" parent="box_stand">
          <mxGeometry x="30" y="130" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hw_illum_zone" value="&lt;b&gt;Illuminated Inspection Zone&lt;/b&gt;&lt;br&gt;Optimized Field of View (FOV) across fabric width" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#facc15;fontSize=11;fontColor=#854d0e;" vertex="1" parent="box_stand">
          <mxGeometry x="30" y="210" width="400" height="50" as="geometry" />
        </mxCell>

        <!-- Subgraph: Sensors & Actuators -->
        <mxCell id="box_sensors" value="&lt;b&gt;Sensing, Illumination &amp;amp; Local Alert Components&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=12;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="590" y="130" width="480" height="340" as="geometry" />
        </mxCell>
        <mxCell id="hw_enc" value="&lt;b&gt;Rotary Encoder&lt;/b&gt; [Confirmed]&lt;br&gt;Incremental Optical Quadrature (A/B Pulses)&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#d97706;&quot;&gt;Coupled mechanically to idler roller shaft&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=11;" vertex="1" parent="box_sensors">
          <mxGeometry x="30" y="45" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hw_cam" value="&lt;b&gt;Industrial Camera&lt;/b&gt; [Confirmed]&lt;br&gt;High-Resolution Area-Scan / Line-Scan Sensor&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#d97706;&quot;&gt;Mounted perpendicular to fabric web plane&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=11;" vertex="1" parent="box_sensors">
          <mxGeometry x="30" y="115" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hw_light" value="&lt;b&gt;LED Lighting Array&lt;/b&gt; [Confirmed]&lt;br&gt;High-CRI Uniform Linear Light Bar / Backlight&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#d97706;&quot;&gt;Suppresses ambient factory light fluctuations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=11;" vertex="1" parent="box_sensors">
          <mxGeometry x="30" y="185" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hw_alert" value="&lt;b&gt;Local Alert Indicator&lt;/b&gt; [Proposed]&lt;br&gt;Visual Stack Tower Light / Audible Relay Buzzer&lt;br&gt;&lt;font style=&quot;font-size: 10px; color:#dc2626;&quot;&gt;Immediate floor notification on uninspected state / major defect&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=11;fontColor=#991b1b;" vertex="1" parent="box_sensors">
          <mxGeometry x="30" y="255" width="420" height="55" as="geometry" />
        </mxCell>

        <!-- Mechanical / Optical Links -->
